<Project Sdk="Microsoft.NET.Sdk">

  <Import Project="$(KitpymesRoot)docs/props/Common.Build.props" Condition="Exists('$(KitpymesRoot)docs/props/Common.Build.props')" />

  <!--
    Comparación con AutoMapper antes de publicar. No se empaqueta ni pasa StyleCop.
    AutoMapper 12.0.1 (licencia MIT, la que usaba el backend; desde la 15 es comercial): sólo se usa aquí, para medir.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <IsTestsProject>true</IsTestsProject>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <RunAnalyzersDuringBuild>false</RunAnalyzersDuringBuild>
    <SignAssembly>false</SignAssembly>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Remove="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="$(KitpymesRoot)Kitpymes.Core.Mapper\Kitpymes.Core.Mapper.csproj" />
    <ProjectReference Include="$(KitpymesRoot)tests\Kitpymes.Core.Mapper.Tests.Ok\Kitpymes.Core.Mapper.Tests.Ok.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="AutoMapper" Version="12.0.1" />
    <PackageReference Include="BenchmarkDotNet" Version="0.15.2" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.0.0" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.0" />
  </ItemGroup>

</Project>
